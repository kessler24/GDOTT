# Copy to .env.local. Only NEXT_PUBLIC_* vars are exposed to the browser —
# never put a secret (Anthropic key, etc.) behind that prefix. Those stay
# server-side in src/recipe_api.

# Base URL of the backend API (src/recipe_api). Local FastAPI dev server by
# default; set to the deployed backend URL (Fly.io/Render) in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
