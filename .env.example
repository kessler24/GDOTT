# Backend (src/recipe_api) — copy to .env and fill in real values.
# .env is gitignored; this file is the only place env vars should be documented.

# Claude API key. Server-side only — never expose this to the browser.
ANTHROPIC_API_KEY=

# Origins allowed to call the API (the deployed web/ app, plus localhost for dev).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Post-MVP (see proposals/proposal.md §5, §7) ---
# DATABASE_URL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
